body {
  background-color: #1a1a24;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  margin: 0;
}

.pixel-character {
  width: 95px;           /* Width of 1 frame */
  height: 100px;         /* Height of 1 frame */
  background-image: url('sprite.png');
  background-image: url('Frames MC01.png');
  background-image: url('Frames MC02.png');
  background-image: url('Frames MC03.png');
  background-image: url('Frames MC04.png');
  background-repeat: no-repeat;
  
  /* Forces the sprite sheet size (380px wide = 95px * 4 frames) */
  background-size: 380px 100px; 
  image-rendering: pixelated;

  animation: play4Frames 0.8s steps(4) infinite;
}

@keyframes play4Frames {
  from {
    background-position: 0px 0px;
  }
  to {
    background-position: -380px 0px;
  }
}

body {
  background-color: #1a1a24;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  margin: 0;
}

.pixel-character {
  width: 95px;
  height: 100px;
  background-repeat: no-repeat;
  image-rendering: pixelated;
  animation: swapFrames 0.8s steps(1) infinite;
}

@keyframes swapFrames {
  0%   { background-image: url('frames MC01.png'); }
  25%  { background-image: url('frames MC02.png'); }
  50%  { background-image: url('frames MC03.png'); }
  75%  { background-image: url('frames MC04.png'); }
}

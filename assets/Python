import numpy as np
from PIL import Image

def expand_idle_animation(sprite_sheet_path, num_source_frames=4):
    # Load original sprite sheet
    sheet = Image.open(sprite_sheet_path).convert("RGBA")
    w, h = sheet.size
    frame_w = w // num_source_frames
    
    # Slice source frames
    frames = [sheet.crop((i * frame_w, 0, (i + 1) * frame_w, h)) for i in range(num_source_frames)]
    
    # Create subtle offset frames for a smoother 8-frame loop
    # Order: [F1, F2, F3, F3_Blink, F2_Lower, F4_Dip, F4_Rest, F1_Rise]
    frame_sequence = [
        frames[0],                       # 1: Base
        frames[1],                       # 2: Rise
        frames[2],                       # 3: Peak
        frames[2],                       # 4: Peak Hold / Blink
        frames[1],                       # 5: Exhale
        frames[3],                       # 6: Dip
        frames[3],                       # 7: Settle
        frames[0]                        # 8: Recovery
    ]
    
    # 1. Save as Animated GIF (8-frame smooth loop)
    frame_sequence[0].save(
        "idle_animation_8frame.gif",
        save_all=True,
        append_images=frame_sequence[1:],
        duration=120,  # 120ms per frame (~8.3 FPS)
        loop=0
    )
    
    # 2. Combine into a 8-frame horizontal Sprite Sheet
    sheet_8frame = Image.new("RGBA", (frame_w * len(frame_sequence), h))
    for idx, img in enumerate(frame_sequence):
        sheet_8frame.paste(img, (idx * frame_w, 0))
        
    sheet_8frame.save("sprite_sheet_8frame.png")
    print("Exported idle_animation_8frame.gif and sprite_sheet_8frame.png")

